---
const projects = [
    {
        id: "rios-trading",
        label: "Client Project · 2024",
        title: "Rios Trading",
        problem:
            "A trading company with no web presence — only social media accounts.",
        solution:
            "Built and deployed a multilingual website (PT/EN/ES) with domain configuration, Hostinger hosting, and direct links to all contact and social channels.",
        tags: ["Elementor", "WordPress", "DNS", "Hostinger", "Registro.br"],
        link: "https://riostrading.com.br",
        linkLabel: "Visit site",
    },
    {
        id: "telegram-postbot",
        label: "Personal Project · 2024",
        title: "Telegram PostBot",
        problem:
            "Creating product posts for social media is repetitive and time-consuming.",
        solution:
            "Self-hosted automation bot that scrapes any marketplace link (Amazon, Mercado Livre, etc.) and generates a humanized, image-ready post for WhatsApp, Instagram, and Facebook.",
        tags: ["n8n", "Ollama", "Puppeteer", "ngrok", "Docker"],
        link: "https://github.com/rock-devv/Telegram-PostBot",
        linkLabel: "Repo coming soon",
    },
];
---

<section id="projects">
    <div id="projects-inner">
        <p class="section-label">Selected work</p>
        <h2 class="section-title">Projects</h2>
        <div id="projects-grid">
            {
                projects.map((project) => (
                    <article class="project-card" id={project.id}>
                        <div class="card-image-placeholder" />
                        <div class="card-body">
                            <p class="card-label">{project.label}</p>
                            <h3 class="card-title">{project.title}</h3>
                            <div class="card-case">
                                <div class="case-block">
                                    <p class="case-heading">Problem</p>
                                    <p class="case-text">{project.problem}</p>
                                </div>
                                <div class="case-block">
                                    <p class="case-heading">Solution</p>
                                    <p class="case-text">{project.solution}</p>
                                </div>
                            </div>
                            <div class="card-tags">
                                {project.tags.map((tag) => (
                                    <span class="tag">{tag}</span>
                                ))}
                            </div>
                            <a
                                href={project.link}
                                class="card-link"
                                target="_blank"
                                rel="noopener noreferrer"
                            >
                                {project.linkLabel} →
                            </a>
                        </div>
                    </article>
                ))
            }
        </div>
    </div>
</section>

<style>
    #projects {
        background-color: var(--color-bg);
        padding: 8rem 8vw;
    }

    #projects-inner {
        max-width: 900px;
    }

    .section-label {
        font-size: 0.8rem;
        font-weight: 500;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--color-accent-bright);
        opacity: 0.8;
        margin-bottom: 0.5rem;
    }

    .section-title {
        font-size: clamp(1.75rem, 4vw, 2.5rem);
        font-weight: 800;
        color: var(--color-text-primary);
        margin: 0 0 3rem;
    }

    #projects-grid {
        display: flex;
        flex-direction: column;
        gap: 3rem;
    }

    .project-card {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 2.5rem;
        border: 0.5px solid var(--color-border);
        border-radius: 12px;
        overflow: hidden;
    }

    .card-image-placeholder {
        background-color: var(--color-surface);
        min-height: 320px;
    }

    .card-body {
        padding: 2rem 2rem 2rem 0;
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .card-label {
        font-size: 0.75rem;
        font-weight: 500;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--color-text-secondary);
    }

    .card-title {
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--color-text-primary);
        margin: 0;
    }

    .card-case {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .case-heading {
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--color-accent-bright);
        margin-bottom: 0.25rem;
    }

    .case-text {
        font-size: 0.9rem;
        color: var(--color-text-secondary);
        line-height: 1.6;
        margin: 0;
    }

    .card-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .tag {
        font-size: 0.75rem;
        padding: 0.25rem 0.65rem;
        border-radius: 9999px;
        border: 0.5px solid var(--color-accent);
        color: var(--color-accent-bright);
    }

    .card-link {
        font-size: 0.85rem;
        font-weight: 500;
        color: var(--color-accent-bright);
        text-decoration: none;
        margin-top: auto;
        transition: letter-spacing 0.2s ease;
    }

    .card-link:hover {
        letter-spacing: 0.04em;
    }
</style>
