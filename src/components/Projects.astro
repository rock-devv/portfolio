---
const projects = [
    {
        id: "rios-trading",
        label: "Website Comercial · 2025",
        title: "Rios Trading",
        image: "/riostrading.webp",
        problem:
            "Uma empresa sem landing page ou presença em buscadores — somente redes sociais.",
        solution:
            "Design, produção e implantação de site multilingual (PT/EN/ES) configuração de domínio e conexão ao servidor Hostinger, links diretos para contato e redes sociais.",
        tags: ["Elementor", "WordPress", "DNS", "Hostinger", "Registro.br"],
        link: "https://riostrading.com.br",
        linkLabel: "Visitar site",
    },
    {
        id: "telegram-postbot",
        label: "Projeto Pessoal · 2026",
        title: "Telegram PostBot",
        image: "/telegrampostbot.webp",
        problem:
            "Extrair informações úteis de produtos e transformar em posts é repetitivo e consome muito tempo.",
        solution:
            "Automação pessoal auto-hospedada com Docker que recebe um link de qualquer marketplace, extrai todas as informações do produto: descrição, preço, desconto, avaliações, e entrega um post pronto com imagem que pode ser usado no Facebook, WhatsApp, Instagram...",
        tags: ["n8n", "Ollama", "Puppeteer", "ngrok", "Docker"],
        link: "https://github.com/rock-devv/Telegram-PostBot",
        linkLabel: "Repositório no Github",
    },
];
---

<section id="projects">
    <div id="projects-inner">
        <p class="section-label">Projetos e Trabalhos</p>
        <h2 class="section-title">Web</h2>
        <div id="projects-grid">
            {
                projects.map((project) => (
                    <article class="project-card" id={project.id}>
                        <img
                            src={project.image}
                            alt={project.title}
                            class="card-image"
                        />{" "}
                        <div class="card-body">
                            <p class="card-label">{project.label}</p>
                            <h3 class="card-title">{project.title}</h3>
                            <div class="card-case">
                                <div class="case-block">
                                    <p class="case-heading">Problema</p>
                                    <p class="case-text">{project.problem}</p>
                                </div>
                                <div class="case-block">
                                    <p class="case-heading">Solução</p>
                                    <p class="case-text">{project.solution}</p>
                                </div>
                            </div>
                            <div class="card-tags">
                                {project.tags.map((tag) => (
                                    <span class="tag">{tag}</span>
                                ))}
                            </div>
                            <a
                                href={project.link}
                                class="card-link"
                                target="_blank"
                                rel="noopener noreferrer"
                            >
                                {project.linkLabel} →
                            </a>
                        </div>
                    </article>
                ))
            }
        </div>
        <br />
    </div>
    <a
        href="https://github.com/rock-devv"
        id="projects-github-cta"
        class="btn"
        target="_blank"
        rel="noopener noreferrer"
    >
        Meus outros projetos no Github &gt;&gt;&gt;
    </a>
</section>

<style>
    #projects {
        background-color: var(--color-bg);
        padding: 8rem 8vw;
    }

    #projects-inner {
        max-width: 900px;
    }

    .section-label {
        font-size: 0.8rem;
        font-weight: 500;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--color-accent-bright);
        opacity: 0.8;
        margin-bottom: 0.5rem;
    }

    .section-title {
        font-size: clamp(1.75rem, 4vw, 2.5rem);
        font-weight: 800;
        color: var(--color-text-primary);
        margin: 0 0 3rem;
    }

    #projects-grid {
        display: flex;
        flex-direction: column;
        gap: 3rem;
    }

    #projects-github-cta {
        margin-top: 3rem;
    }

    .project-card {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 2.5rem;
        border: 0.5px solid var(--color-border);
        border-radius: 12px;
        overflow: hidden;
    }

    .card-image {
        width: 100%;
        height: 100%;
        min-height: 320px;
        object-fit: cover;
        object-position: center top;
        display: block;
    }

    .card-body {
        padding: 2rem 2rem 2rem 0;
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .card-label {
        font-size: 0.75rem;
        font-weight: 500;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--color-text-secondary);
    }

    .card-title {
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--color-text-primary);
        margin: 0;
    }

    .card-case {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .case-heading {
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--color-accent-bright);
        margin-bottom: 0.25rem;
    }

    .case-text {
        font-size: 0.9rem;
        color: var(--color-text-secondary);
        line-height: 1.6;
        margin: 0;
    }

    .card-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .tag {
        font-size: 0.75rem;
        padding: 0.25rem 0.65rem;
        border-radius: 9999px;
        border: 0.5px solid var(--color-accent);
        color: var(--color-accent-bright);
    }

    .card-link {
        font-size: 0.85rem;
        font-weight: 500;
        color: var(--color-accent-bright);
        text-decoration: none;
        margin-top: auto;
        transition: letter-spacing 0.2s ease;
    }

    .card-link:hover {
        letter-spacing: 0.04em;
    }
</style>
