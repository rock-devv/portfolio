---

---

<section id="hero">
    <div id="hero-content">
        <p id="hero-label">Based in Brazil · Available for freelance</p>
        <h1 id="hero-headline">Web Developer<br />& IT Nerd</h1>
        <p id="hero-sub">Networks, automation, and web — that's my stack.</p>
        <a href="#projects" id="hero-cta">See my work</a>
    </div>
</section>

<style>
    #hero {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: flex-start;
        background-color: #080f0b;
        padding: 2rem 8vw;
        gap: 2rem;
    }

    #hero-content {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        text-align: left;
        gap: 1.25rem;
        max-width: 600px;
    }

    #hero-label {
        font-size: 0.8rem;
        font-weight: 500;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: #1db954;
        opacity: 0.8;
    }

    #hero-headline {
        font-size: clamp(2rem, 4vw, 3rem);
        font-weight: 800;
        line-height: 1.2;
        letter-spacing: -0.03em;
        color: #f0f0f0;
        margin: 0;
    }

    #hero-sub {
        font-size: clamp(1rem, 2vw, 1.2rem);
        color: rgba(240, 240, 240, 0.5);
        margin: 0;
        max-width: 480px;
    }

    #hero-cta {
        margin-top: 0.5rem;
        padding: 0.75rem 2rem;
        border-radius: 9999px;
        background: transparent;
        border: 1px solid #1a5c3a;
        color: #1db954;
        font-size: 0.9rem;
        font-weight: 500;
        text-decoration: none;
        letter-spacing: 0.04em;
        transition:
            background 0.2s ease,
            color 0.2s ease;
    }

    #hero-cta:hover {
        background: #1a5c3a;
        color: #f0f0f0;
    }
</style>
